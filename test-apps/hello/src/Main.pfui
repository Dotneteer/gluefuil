<!-- Step 14: an inline component (XMLUI user-defined-components.md) -->
<Component name="NameValue">
  <Stack orientation="horizontal" gap="4px">
    <Text>Name: {$props.name}</Text>
    <Text>Value: {$props.value ?? '[no value]'}</Text>
  </Stack>
</Component>

<App var.count="{0}" var.source="{0}" var.mirror="{source}" var.status="Idle">
  <Stack gap="8px">
    <Text value="{1 + 2}"/>
    <Text>Hello, {'pfui'.toUpperCase()}!</Text>
    <Text>{[1, 2, 3].map(n => n * n).join(' + ')} = {[1, 2, 3].reduce((sum, n) => sum + n * n, 0)}</Text>
    <Stack orientation="horizontal" gap="4px">
      <Button label="First"/>
      <Button>Second</Button>
    </Stack>

    <!-- Step 6: a counter -->
    <Stack orientation="horizontal" gap="4px">
      <Button label="Increment" onClick="count++"/>
      <Text>Count: {count}</Text>
    </Stack>

    <!-- Step 6: a variable follows its expression until assigned (XMLUI markup.md) -->
    <Text>source = {source}</Text>
    <Text>mirror = {mirror}</Text>
    <Stack orientation="horizontal" gap="4px">
      <Button label="Increment source" onClick="source++"/>
      <Button label="Override mirror" onClick="mirror = 999"/>
    </Stack>

    <!-- Step 8: component IDs (file-scoped, order-independent) -->
    <Text>Greeting: Hello, {nameBox.value || 'stranger'}!</Text>
    <Stack orientation="horizontal" gap="4px">
      <TextBox id="nameBox" placeholder="Your name"/>
      <Button label="Shout" onClick="nameBox.setValue(nameBox.value.toUpperCase())"/>
      <Button label="Reset name" onClick="nameBox.setValue(''); nameBox.focus()"/>
    </Stack>

    <!-- Step 9: source maps (e2e/source-maps.spec.ts pauses on this throw) -->
    <Button
      label="Throw"
      onClick="
        const reason = 'source maps';
        throw new Error('thrown in Main.pfui: ' + reason);
      "/>

    <!-- Step 10: responsive when -->
    <Text when-md="false">Layout: compact</Text>
    <Text when="false" when-md="true">Layout: wide</Text>

    <!-- Step 10: Items with $item / $itemIndex -->
    <Stack var.todos="{['Write tests']}" gap="4px">
      <Button label="Add todo" onClick="todos.push('Todo ' + (todos.length + 1))"/>
      <Items data="{todos}">
        <Stack orientation="horizontal" gap="4px">
          <Text>Todo #{$itemIndex + 1}: {$item}</Text>
          <Button label="{'Remove ' + $item}" onClick="todos.splice($itemIndex, 1)"/>
        </Stack>
      </Items>
    </Stack>

    <!-- Step 7: a slow handler (implicit await) -->
    <Stack orientation="horizontal" gap="4px">
      <Button label="Save" onClick="status = 'Saving…'; delay(300); status = 'Saved'"/>
      <Text>Status: {status}</Text>
    </Stack>

    <!-- Step 7: handler policies (double-click each button) -->
    <Stack orientation="horizontal" gap="4px" var.log="{[]}" var.n="{0}">
      <Button label="parallel" onClick="const i = ++n; log.push('s' + i); delay(150); log.push('e' + i)"/>
      <Text>parallel: {log.join(',')}</Text>
    </Stack>
    <Stack orientation="horizontal" gap="4px" var.log="{[]}" var.n="{0}">
      <Button label="single-flight" handlerPolicy="single-flight" onClick="const i = ++n; log.push('s' + i); delay(150); log.push('e' + i)"/>
      <Text>single-flight: {log.join(',')}</Text>
    </Stack>
    <Stack orientation="horizontal" gap="4px" var.log="{[]}" var.n="{0}">
      <Button label="queue" handlerPolicy="queue" onClick="const i = ++n; log.push('s' + i); delay(150); log.push('e' + i)"/>
      <Text>queue: {log.join(',')}</Text>
    </Stack>
    <Stack orientation="horizontal" gap="4px" var.log="{[]}" var.n="{0}">
      <Button label="drop-while-running" handlerPolicy="drop-while-running" onClick="const i = ++n; log.push('s' + i); delay(150); log.push('e' + i)"/>
      <Text>drop-while-running: {log.join(',')}</Text>
    </Stack>

    <!-- Step 14: user-defined components (components/*.pfui) -->
    <NameValue name="Mary" value="123"/>
    <NameValue name="Joe"/>
    <Stack var.increments="" gap="4px">
      <IncButton onIncremented="(clickCount) => increments += ' ' + clickCount"/>
      <Text>Increments:{increments}</Text>
    </Stack>
    <Counter id="counter1"/>
    <Button label="Reset counter (external)" onClick="counter1.reset()"/>
    <StatusList items="{[{ label: 'Build', ok: true }, { label: 'Tests', ok: false }]}">
      <property name="rowTemplate">
        <Text>{$item.ok ? 'passed' : 'failed'}: {$item.label}</Text>
      </property>
    </StatusList>
    <StatusList items="{[{ label: 'Deploy' }]}"/>
    <Panel title="with content"><Text>Panel content: count is {count}</Text></Panel>
    <Panel title="empty"/>
    <Text>{shout('code-behind')}</Text>

    <!-- Step 17: theming -->
    <Stack orientation="horizontal" gap="4px">
      <Button label="Toggle tone" onClick="toggleThemeTone()"/>
      <Text>Tone: {activeThemeTone}</Text>
    </Stack>
    <Theme backgroundColor-Button="rgb(220, 38, 38)">
      <Button label="Themed button"/>
    </Theme>
    <Theme tone="dark">
      <Text>Dark region</Text>
    </Theme>

    <!-- Step 18: behaviors -->
    <Button label="Hover me" tooltip="A tooltip from the tooltip behavior"/>
    <TextBox label="Labeled input" placeholder="type here"/>
    <Theme backgroundColor-Button-danger="rgb(185, 28, 28)">
      <Button label="Danger variant" variant="danger"/>
      <Button label="Unknown variant" variant="nothing"/>
    </Theme>
  </Stack>
</App>
