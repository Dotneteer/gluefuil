<Component name="RoutingScenario">
  <VStack>
    <ScenarioHeader title="Routing" description="Steps 19, 21 and 21B: navigate(), Link, route and query parameters; App willNavigate and didNavigate; the guard's flag and the log are globals of Main.pfui."/>
    <VStack>
      <Text>$pathname = {$pathname}</Text>
      <HStack>
        <Button label="Item 1" onClick="navigate('/routing/1')"/>
        <Button label="Item 42 with a query" onClick="navigate('/routing/42?color=green&amp;size=L')"/>
        <Link to="/routing/hello%20world">A link with an encoded segment</Link>
      </HStack>
      <Link to="/no/such/page">An unknown route (falls back to the dashboard)</Link>
    </VStack>
    <VStack>
      <Text variant="strong">A navigation guard (App onWillNavigate in Main.pfui)</Text>
      <Checkbox label="Unsaved changes: block every navigation" initialValue="{unsavedChanges}" onDidChange="(value) => unsavedChanges = value"/>
      <Text variant="secondary">While checked, buttons, links, the nav panel and the browser's back button all stay on this page.</Text>
      <Text>Last navigations (App onDidNavigate): {navigationLog.join(' ← ') || 'none yet'}</Text>
    </VStack>
  </VStack>
</Component>
