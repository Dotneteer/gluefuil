<Component name="TemplatesScenario">
  <VStack>
    <ScenarioHeader title="Items and templates" description="Step 10: Items renders a template per item with $item, $itemIndex, $isFirst, $isLast; ids in a template belong to its row."/>
    <VStack var.todos="{['Write tests', 'Fix bugs', 'Ship it']}" var.reversed="{false}">
      <HStack>
        <Button label="Add" onClick="todos.push('Todo ' + (todos.length + 1))"/>
        <Button label="{reversed ? 'Normal order' : 'Reverse'}" onClick="reversed = !reversed"/>
      </HStack>
      <Items data="{todos}" reverse="{reversed}">
        <HStack>
          <Text>#{$itemIndex + 1}{$isFirst ? ' (first)' : ''}{$isLast ? ' (last)' : ''}: {$item}</Text>
          <TextBox id="note" placeholder="A note for this row"/>
          <Text variant="secondary">{note.value ? 'note: ' + note.value : ''}</Text>
          <Button label="Remove" onClick="todos.splice(todos.indexOf($item), 1)"/>
        </HStack>
      </Items>
    </VStack>
    <H3>An explicit template property</H3>
    <Items data="{[{ name: 'Ada' }, { name: 'Grace' }]}">
      <property name="itemTemplate">
        <Text>Hello, {$item.name}!</Text>
      </property>
    </Items>
  </VStack>
</Component>
