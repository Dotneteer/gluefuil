<Component name="ThemingScenario">
  <VStack>
    <ScenarioHeader title="Theming" description="Step 17: switch the tone and the theme; scoped Theme elements override variables."/>
    <VStack>
      <HStack>
        <Button label="Toggle tone" onClick="toggleThemeTone()"/>
        <Button label="Default theme" onClick="setTheme('gfui')"/>
        <Button label="Green theme" onClick="setTheme('gfui-green')"/>
        <Button label="Red theme" onClick="setTheme('gfui-red')"/>
      </HStack>
      <Text>Tone: {activeThemeTone}, theme: {activeThemeId}</Text>
      <Theme backgroundColor-Button="$color-warn-500">
        <Button label="A Button in a scoped Theme"/>
      </Theme>
      <Theme tone="dark">
        <Text>This text is in a dark-tone region.</Text>
      </Theme>
      <Theme backgroundColor-Button-danger="$color-danger-600">
        <Button label="variant=danger" variant="danger"/>
      </Theme>
    </VStack>
  </VStack>
</Component>
