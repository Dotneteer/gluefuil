<!--
  The App shell (steps 19A–19C). This playground itself uses it (the side nav,
  the header, the footer). Each layout below is its own App, in a frame.
-->
<Component name="AppShellScenario">
  <VStack>
    <ScenarioHeader
      title="App shell"
      description="XMLUI's App layouts expressed with placement, fullHeight, sticky and scroll. Pick one, scroll inside the frame, try the phone width."/>
    <Text>
      The nav goes in one of four places; everything else stays put. Below the
      breakpoint (drawerBelow, default lg) the nav becomes a drawer opened from the header.
    </Text>
    <HStack>
      <Button label="Collapse this playground's nav: {navPanelCollapsed}" onClick="setNavPanelCollapsed(!navPanelCollapsed)"/>
    </HStack>
    <LayoutPreview/>
  </VStack>
</Component>
