<Component name="InputsScenario">
  <VStack>
    <ScenarioHeader title="Inputs" description="Step 16: Mantine inputs bound to variables through their events and APIs."/>
    <VStack var.fruit="none" var.agreed="{false}">
      <TextBox id="nameBox" label="Name" placeholder="Type your name"/>
      <Text>Hello, {nameBox.value || 'stranger'}!</Text>
      <Button label="Shout" onClick="nameBox.setValue(nameBox.value.toUpperCase())"/>
      <Select placeholder="Pick a fruit" clearable searchable data="{[{ value: 'a', label: 'Apple' }, { value: 'b', label: 'Banana' }, { value: 'c', label: 'Cherry' }]}" onDidChange="(v) => fruit = v || 'none'">
        <property name="optionTemplate">
          <Text>{$checked ? '✓ ' : ''}{$item.label} ({$item.value})</Text>
        </property>
      </Select>
      <Text>Fruit: {fruit}</Text>
      <Checkbox label="I agree" onDidChange="(v) => agreed = v"/>
      <Text>Agreed: {agreed}</Text>
      <Button label="Only enabled when you agree" enabled="{agreed}" onClick="fruit = 'button clicked'"/>
    </VStack>
  </VStack>
</Component>
