<!-- Step 28: ResponsiveBar. -->
<Component name="ResponsiveBarScenario">
  <VStack var.log="" var.width="{100}">
    <ScenarioHeader title="Responsive bars" description="Children that don't fit move into a menu; each child knows ($overflow); a vertical bar; a bar whose width you change. (Direct children: an Items is one child.)"/>

    <Card title="A toolbar">
      <Slider label="Width (%)" minValue="20" maxValue="100" initialValue="100" onDidChange="(v) => width = v"/>
      <ResponsiveBar id="toolbar" width="{width + '%'}" gap="8px">
        <Button label="{$overflow ? 'File (in the menu)' : 'File'}" onClick="log = 'clicked File'"/>
        <Button label="{$overflow ? 'Edit (in the menu)' : 'Edit'}" onClick="log = 'clicked Edit'"/>
        <Button label="{$overflow ? 'View (in the menu)' : 'View'}" onClick="log = 'clicked View'"/>
        <Button label="{$overflow ? 'Selection (in the menu)' : 'Selection'}" onClick="log = 'clicked Selection'"/>
        <Button label="{$overflow ? 'Go (in the menu)' : 'Go'}" onClick="log = 'clicked Go'"/>
        <Button label="{$overflow ? 'Run (in the menu)' : 'Run'}" onClick="log = 'clicked Run'"/>
        <Button label="{$overflow ? 'Terminal (in the menu)' : 'Terminal'}" onClick="log = 'clicked Terminal'"/>
        <Button label="{$overflow ? 'Help (in the menu)' : 'Help'}" onClick="log = 'clicked Help'"/>
      </ResponsiveBar>
      <Text>Overflow: {toolbar.hasOverflow}</Text>
    </Card>

    <Card title="Vertical">
      <ResponsiveBar orientation="vertical" height="150px" gap="4px">
        <Button label="One"/>
        <Button label="Two"/>
        <Button label="Three"/>
        <Button label="Four"/>
        <Button label="Five"/>
        <Button label="Six"/>
      </ResponsiveBar>
    </Card>

    <Text>log: {log}</Text>
  </VStack>
</Component>
