<Component name="VariablesScenario">
  <VStack>
    <ScenarioHeader title="Variables" description="Step 6: variables follow their expression until assigned; deep writes and array mutations copy on write."/>
    <H3>Follow until assigned</H3>
    <VStack var.source="{1}" var.mirror="{source * 10}">
      <Text>source = {source}, mirror = {mirror}</Text>
      <HStack>
        <Button label="source++" onClick="source++"/>
        <Button label="Assign mirror = 0 (stops following)" onClick="mirror = 0"/>
      </HStack>
    </VStack>
    <H3>Deep writes</H3>
    <VStack var.user="{({ name: 'Ada', address: { city: 'London' } })}">
      <Text>{user.name} lives in {user.address.city}.</Text>
      <HStack>
        <Button label="Move to Paris" onClick="user.address.city = 'Paris'"/>
        <Button label="Add an exclamation" onClick="user.name += '!'"/>
        <Button label="Delete the city" onClick="delete user.address.city"/>
      </HStack>
    </VStack>
    <H3>Array mutations</H3>
    <VStack var.list="{['banana', 'apple', 'cherry']}">
      <Text>{list.join(', ') || '(empty)'}</Text>
      <HStack>
        <Button label="push" onClick="list.push('item ' + (list.length + 1))"/>
        <Button label="remove first" onClick="list.splice(0, 1)"/>
        <Button label="sort" onClick="list.sort()"/>
        <Button label="reverse" onClick="list.reverse()"/>
      </HStack>
    </VStack>
    <H3>The variable tag</H3>
    <VStack>
      <variable name="tagged" value="declared with a variable tag"/>
      <Text>{tagged}</Text>
    </VStack>
  </VStack>
</Component>
