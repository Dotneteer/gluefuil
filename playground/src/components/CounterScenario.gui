<Component name="CounterScenario">
  <VStack>
    <ScenarioHeader title="Counter" description="Steps 5-6: a first app. Click to change a variable; the texts follow it."/>
    <VStack var.count="{0}">
      <HStack>
        <Button label="Increment" onClick="count++"/>
        <Button label="Reset" onClick="count = 0"/>
      </HStack>
      <Text>Count: {count}</Text>
      <Text>Doubled: {count * 2}</Text>
      <Text when="{count >= 5}" variant="strong">Five or more!</Text>
    </VStack>
  </VStack>
</Component>
