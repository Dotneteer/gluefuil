<Component name="AsyncScenario">
  <VStack>
    <ScenarioHeader title="Async handlers" description="Step 7: implicit await, handler policies, cancellation and timeouts."/>
    <H3>Implicit await</H3>
    <HStack var.status="Idle">
      <Button label="Save (1 s)" onClick="status = 'Saving…'; delay(1000); status = 'Saved at ' + new Date().toLocaleTimeString()"/>
      <Text>Status: {status}</Text>
    </HStack>
    <H3>Policies (click several times quickly)</H3>
    <VStack var.log="{[]}">
      <HStack>
        <Button label="parallel" onClick="const id = log.length; log.push('p' + id + ' start'); delay(800); log.push('p' + id + ' end')"/>
        <Button label="queue" handlerPolicy="queue" onClick="const id = log.length; log.push('q' + id + ' start'); delay(800); log.push('q' + id + ' end')"/>
        <Button label="single-flight" handlerPolicy="single-flight" onClick="const id = log.length; log.push('s' + id + ' start'); delay(800); log.push('s' + id + ' end')"/>
        <Button label="drop-while-running" handlerPolicy="drop-while-running" onClick="const id = log.length; log.push('d' + id + ' start'); delay(800); log.push('d' + id + ' end')"/>
        <Button label="Clear" onClick="log = []"/>
      </HStack>
      <Text>{log.join(' · ') || '(nothing yet)'}</Text>
    </VStack>
    <H3>Cancellation</H3>
    <VStack var.progress="">
      <Button
        label="Long job (click again to restart it)"
        handlerPolicy="single-flight"
        onClick="for (let i = 1; i &lt;= 5; i++) { progress = 'step ' + i + ' of 5'; delay(700); } progress = 'done'"/>
      <Text>Progress: {progress}</Text>
      <VStack var.timed="">
        <Button label="A 3 s job with a 1 s timeout" handlerTimeoutMs="1000" onClick="timed = 'started'; delay(3000); timed = 'finished (should not happen)'"/>
        <Text>Timed job: {timed || '(not started)'}</Text>
      </VStack>
      <Text variant="secondary">A cancelled handler stops at its next await; navigating away from this page cancels running handlers too.</Text>
    </VStack>
  </VStack>
</Component>
