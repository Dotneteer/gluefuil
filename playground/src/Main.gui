<!--
  The playground: a dashboard of scenarios, each on its own page with its source.
  To add a scenario: create src/components/<Name>Scenario.gui (starting with
  <ScenarioHeader>), add an entry to `scenarios` below, and a <Page> for it.
  See README.md.

  Navigation events (step 21): while `unsavedChanges` is set (the Routing
  scenario's checkbox), willNavigate cancels every navigation; didNavigate
  keeps the last five paths for that scenario to show. Both are globals
  (step 21B), so the scenario reads and writes them directly.

  The App shell (steps 19A–19C): a header with the tone toggle, a collapsible
  side nav built from `scenarios`, and a footer. Below the lg breakpoint the
  nav moves into a drawer, opened from the header.
-->
<App
  var.scenarios="{[
    { path: '/markup', step: '2', title: 'Markup', description: 'Entities, CDATA, comments, whitespace, escaped braces.' },
    { path: '/expressions', step: '2–3', title: 'Expressions', description: 'The script language in bindings; allowed globals.' },
    { path: '/reactivity', step: '4', title: 'Reactivity', description: 'Derived values, glitch-free updates, batching.' },
    { path: '/counter', step: '5–6', title: 'Counter', description: 'A first app: variables, handlers and reactive text.' },
    { path: '/variables', step: '6', title: 'Variables', description: 'Follow until assigned, deep writes, array mutations.' },
    { path: '/async', step: '7', title: 'Async handlers', description: 'Implicit await, policies, cancellation, timeouts.' },
    { path: '/ids', step: '8', title: 'Component IDs', description: 'APIs through ids, in any order: value, setValue, focus.' },
    { path: '/source-maps', step: '9', title: 'Source maps', description: 'A handler error points to its .gui line.' },
    { path: '/conditionals', step: '10', title: 'Conditionals', description: 'when, responsive when-*, onMount / onUnmount.' },
    { path: '/templates', step: '10', title: 'Items and templates', description: 'Item templates, context variables, ids per row.' },
    { path: '/user-components', step: '14', title: 'User-defined components', description: 'Props, events, methods, slots, code-behind.' },
    { path: '/live', step: '3, 15', title: 'Live compiler', description: 'Type markup: diagnostics, generated code, result.' },
    { path: '/inputs', step: '16', title: 'Inputs', description: 'Mantine TextBox, Select and Checkbox bound to variables.' },
    { path: '/text', step: '16', title: 'Text and headings', description: 'Text variants, Heading and H1–H6.' },
    { path: '/theming', step: '17', title: 'Theming', description: 'Tone switching, scoped themes, variants.' },
    { path: '/behaviors', step: '18', title: 'Behaviors', description: 'label, tooltip and variant on any component.' },
    { path: '/routing', step: '19, 21', title: 'Routing', description: 'navigate, Link, route and query parameters; a navigation guard and log.' },
    { path: '/app-shell', step: '19A–C', title: 'App shell', description: 'Header, nav, footer: every XMLUI layout, desktop and phone.' },
    { path: '/layout', step: '19D–F', title: 'Layout and spacing', description: 'Stacks, flows and sizes; automatic gaps and paddings.' },
    { path: '/data', step: '20', title: 'Data', description: 'DataSource and APICall against a mock backend; slow and broken networks.' },
    { path: '/forms', step: '22, 22B', title: 'Forms', description: 'Inputs bound with bindTo, validation, loading and saving, server errors.' },
    { path: '/display', step: '23', title: 'Display', description: 'Icons, images, avatars, badges, progress, cards, links, text overflow, Markdown.' },
    { path: '/icons', step: '23', title: 'Icons', description: 'Every built-in icon: filter, sizes, fallback, color.' },
    { path: '/media', step: '23', title: 'Images and avatars', description: 'Image fit, aspect ratio, grayscale, inline; Avatar initials, pictures, sizes.' },
    { path: '/status', step: '23', title: 'Status indicators', description: 'Badge colorMap, a simulated download, spinner delays, separators.' },
    { path: '/cards', step: '23', title: 'Cards', description: 'Cards from data, selection, title rows, orientation, nesting, theming.' },
    { path: '/links', step: '23', title: 'Links and text', description: 'Link kinds, text overflow at three widths, heading anchors, hasOverflow().' },
    { path: '/markdown', step: '23', title: 'Markdown', description: 'GFM samples, the HTML allowlist, @{…} bindings, a data URL.' },
    { path: '/text-inputs', step: '24', title: 'Text inputs', description: 'TextBox types and adornments, PasswordInput, TextArea, NumberBox.' },
    { path: '/choice-inputs', step: '24', title: 'Choice inputs', description: 'Checkbox, Switch, RadioGroup, Slider (value and range), ColorPicker.' },
    { path: '/input-form', step: '24', title: 'Input form', description: 'Every input bound to a Form: validation, submit, reset.' },
    { path: '/input-apis', step: '24', title: 'Input APIs and theming', description: 'setValue, focus and value from code; two inputs in sync; Enter in a TextArea; icons; theme variables.' },
    { path: '/select', step: '25', title: 'Select', description: 'Option children or data; search, several values, groups, templates, keys, the API.' },
    { path: '/autocomplete', step: '25', title: 'AutoComplete', description: 'Type to filter, several values, new ones; both pickers in a Form.' },
    { path: '/date-time', step: '26', title: 'Date and time inputs', description: 'DateInput in each dateFormat, limits; TimeInput in 24- and 12-hour mode; isoValue().' },
    { path: '/date-picker', step: '26', title: 'DatePicker', description: 'A calendar inline or in a popup, ranges and presets, disabled dates; dates in a Form.' },
    { path: '/dialogs', step: '27', title: 'Dialogs and drawers', description: 'ModalDialog by open() or when, $param, a Form inside, unsaved changes, willClose; Drawer.' },
    { path: '/menus', step: '27', title: 'Menus and tooltips', description: 'DropdownMenu with a submenu, a context menu at the pointer, tooltips with options.' },
    { path: '/notifications', step: '27', title: 'Toasts and confirm', description: 'toast() and its kinds, confirm(), an APICall that asks first and reports.' },
    { path: '/tabs', step: '28', title: 'Tabs and steppers', description: 'Tabs from TabItems and Items, vertical and accordion; ExpandableItem; Stepper with states.' },
    { path: '/splitters', step: '28', title: 'Splitters and scrolling', description: 'Splitters with limits and resize modes; ScrollViewer styles; sticky sections and boxes.' },
    { path: '/responsive-bar', step: '28', title: 'Responsive bars', description: 'Children that do not fit move into a menu; $overflow; a vertical bar.' },
    { path: '/long-lists', step: '29', title: 'Long lists', description: 'A virtualized List of 10,000 rows of different heights; its own scroll box and the page.' },
    { path: '/chat-feed', step: '29', title: 'Chat feed', description: 'A List anchored to the bottom: follows new messages, keeps its place when older ones load.' },
    { path: '/grouped-lists', step: '29', title: 'Grouped and selectable lists', description: 'Groups that fold; selection by mouse, keys and checkboxes; syncWithVar; actions.' },
    { path: '/tables', step: '30', title: 'Tables', description: '10,000 rows: sorting, selection, pinned and resizable columns, copying cells.' },
    { path: '/table-types', step: '30', title: 'Table columns and types', description: 'Columns inferred from the data; every Column type; the Value component.' },
    { path: '/editable-tables', step: '30', title: 'Editable and paged tables', description: 'Switches, checkboxes and colors in cells; row details; paging; Pagination.' }
  ]}"
  global.unsavedChanges="{false}"
  global.navigationLog="{[]}"
  onWillNavigate="(to) => { if (unsavedChanges) return false; }"
  onDidNavigate="(to) => { navigationLog = [to, ...navigationLog].slice(0, 5); }">
  <AppHeader title="gfui playground">
    <NavPanelCollapseButton/>
    <property name="profileMenuTemplate">
      <Button label="Tone: {activeThemeTone}" onClick="toggleThemeTone()"/>
    </property>
  </AppHeader>
  <NavPanel placement="side" collapsible="true">
    <NavLink label="Dashboard" to="/" icon="home"/>
    <Items data="{scenarios}">
      <NavLink label="{$item.title}" to="{$item.path}"/>
    </Items>
  </NavPanel>
  <Pages fallbackPath="/">
    <Page url="/">
      <VStack>
        <H1>gfui playground</H1>
        <Text variant="secondary">Pick a scenario. Each page shows its source and has a way back to this dashboard.</Text>
        <VStack>
          <Items data="{scenarios}">
            <HStack verticalAlignment="center">
              <Text variant="mono">Step {$item.step}</Text>
              <Button label="{$item.title}" onClick="navigate($item.path)"/>
              <Text variant="secondary">{$item.description}</Text>
            </HStack>
          </Items>
        </VStack>
      </VStack>
    </Page>

    <Page url="/markup"><VStack><MarkupScenario/><ScenarioSource file="MarkupScenario"/></VStack></Page>
    <Page url="/expressions"><VStack><ExpressionsScenario/><ScenarioSource file="ExpressionsScenario"/></VStack></Page>
    <Page url="/reactivity"><VStack><ReactivityScenario/><ScenarioSource file="ReactivityScenario"/></VStack></Page>
    <Page url="/counter"><VStack><CounterScenario/><ScenarioSource file="CounterScenario"/></VStack></Page>
    <Page url="/variables"><VStack><VariablesScenario/><ScenarioSource file="VariablesScenario"/></VStack></Page>
    <Page url="/async"><VStack><AsyncScenario/><ScenarioSource file="AsyncScenario"/></VStack></Page>
    <Page url="/ids"><VStack><IdsScenario/><ScenarioSource file="IdsScenario"/></VStack></Page>
    <Page url="/source-maps"><VStack><SourceMapsScenario/><ScenarioSource file="SourceMapsScenario"/></VStack></Page>
    <Page url="/conditionals"><VStack><ConditionalsScenario/><ScenarioSource file="ConditionalsScenario"/></VStack></Page>
    <Page url="/templates"><VStack><TemplatesScenario/><ScenarioSource file="TemplatesScenario"/></VStack></Page>
    <Page url="/user-components">
      <VStack>
        <UserComponentsScenario/>
        <ScenarioSource file="UserComponentsScenario"/>
        <ScenarioSource file="DemoRating"/>
        <ScenarioSource file="DemoCounter"/>
        <ScenarioSource file="DemoCard"/>
      </VStack>
    </Page>
    <Page url="/live"><VStack><LiveCompilerScenario/><ScenarioSource file="LiveCompilerScenario"/></VStack></Page>
    <Page url="/inputs"><VStack><InputsScenario/><ScenarioSource file="InputsScenario"/></VStack></Page>
    <Page url="/text"><VStack><TextScenario/><ScenarioSource file="TextScenario"/></VStack></Page>
    <Page url="/theming"><VStack><ThemingScenario/><ScenarioSource file="ThemingScenario"/></VStack></Page>
    <Page url="/behaviors"><VStack><BehaviorsScenario/><ScenarioSource file="BehaviorsScenario"/></VStack></Page>
    <Page url="/routing"><VStack><RoutingScenario/><ScenarioSource file="RoutingScenario"/></VStack></Page>
    <Page url="/routing/:item"><VStack><RoutingDetailScenario/><ScenarioSource file="RoutingDetailScenario"/></VStack></Page>
    <Page url="/data"><VStack><DataScenario/><ScenarioSource file="DataScenario"/></VStack></Page>
    <Page url="/forms"><VStack><FormsScenario/><ScenarioSource file="FormsScenario"/></VStack></Page>
    <Page url="/display"><VStack><DisplayScenario/><ScenarioSource file="DisplayScenario"/></VStack></Page>
    <Page url="/icons"><VStack><IconsScenario/><ScenarioSource file="IconsScenario"/></VStack></Page>
    <Page url="/media"><VStack><MediaScenario/><ScenarioSource file="MediaScenario"/></VStack></Page>
    <Page url="/status"><VStack><StatusScenario/><ScenarioSource file="StatusScenario"/></VStack></Page>
    <Page url="/cards"><VStack><CardsScenario/><ScenarioSource file="CardsScenario"/></VStack></Page>
    <Page url="/links"><VStack><LinksTextScenario/><ScenarioSource file="LinksTextScenario"/></VStack></Page>
    <Page url="/markdown"><VStack><MarkdownScenario/><ScenarioSource file="MarkdownScenario"/></VStack></Page>
    <Page url="/text-inputs"><VStack><TextInputsScenario/><ScenarioSource file="TextInputsScenario"/></VStack></Page>
    <Page url="/choice-inputs"><VStack><ChoiceInputsScenario/><ScenarioSource file="ChoiceInputsScenario"/></VStack></Page>
    <Page url="/input-form"><VStack><InputFormScenario/><ScenarioSource file="InputFormScenario"/></VStack></Page>
    <Page url="/input-apis"><VStack><InputApisScenario/><ScenarioSource file="InputApisScenario"/><ScenarioSource file="InputSampler"/></VStack></Page>
    <Page url="/select"><VStack><SelectScenario/><ScenarioSource file="SelectScenario"/></VStack></Page>
    <Page url="/autocomplete"><VStack><AutoCompleteScenario/><ScenarioSource file="AutoCompleteScenario"/></VStack></Page>
    <Page url="/date-time"><VStack><DateTimeScenario/><ScenarioSource file="DateTimeScenario"/></VStack></Page>
    <Page url="/date-picker"><VStack><DatePickerScenario/><ScenarioSource file="DatePickerScenario"/></VStack></Page>
    <Page url="/dialogs"><VStack><DialogsScenario/><ScenarioSource file="DialogsScenario"/></VStack></Page>
    <Page url="/menus"><VStack><MenusScenario/><ScenarioSource file="MenusScenario"/></VStack></Page>
    <Page url="/notifications"><VStack><NotificationsScenario/><ScenarioSource file="NotificationsScenario"/></VStack></Page>
    <Page url="/tabs"><VStack><TabsScenario/><ScenarioSource file="TabsScenario"/></VStack></Page>
    <Page url="/splitters"><VStack><SplittersScenario/><ScenarioSource file="SplittersScenario"/></VStack></Page>
    <Page url="/responsive-bar"><VStack><ResponsiveBarScenario/><ScenarioSource file="ResponsiveBarScenario"/></VStack></Page>
    <Page url="/long-lists"><VStack><LongListsScenario/><ScenarioSource file="LongListsScenario"/></VStack></Page>
    <Page url="/chat-feed"><VStack><ChatFeedScenario/><ScenarioSource file="ChatFeedScenario"/></VStack></Page>
    <Page url="/grouped-lists"><VStack><GroupedListsScenario/><ScenarioSource file="GroupedListsScenario"/></VStack></Page>
    <Page url="/tables"><VStack><TablesScenario/><ScenarioSource file="TablesScenario"/></VStack></Page>
    <Page url="/table-types"><VStack><TableTypesScenario/><ScenarioSource file="TableTypesScenario"/></VStack></Page>
    <Page url="/editable-tables"><VStack><EditableTablesScenario/><ScenarioSource file="EditableTablesScenario"/></VStack></Page>
    <Page url="/layout"><VStack><LayoutScenario/><ScenarioSource file="LayoutScenario"/></VStack></Page>
    <Page url="/app-shell"><VStack><AppShellScenario/><ScenarioSource file="AppShellScenario"/><ScenarioSource file="LayoutDemoLinks"/><ScenarioSource file="LayoutDemoPages"/></VStack></Page>
  </Pages>
  <Footer sticky="false">
    <Text variant="secondary">gfui playground: manual testing for the proof-of-concept steps.</Text>
  </Footer>
</App>
